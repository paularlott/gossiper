# Load balancer for the three nodes' Mercure hubs.
{
	admin off
}

:8080 {
	reverse_proxy node1:8080 node2:8080 node3:8080 {
		lb_policy round_robin

		# A node that stops is taken out of rotation: /readyz answers while it serves, and a failed request marks it
		# unhealthy for a while. A request that finds its node down is retried on another one.
		health_uri /readyz
		health_interval 2s
		health_timeout 1s
		fail_duration 10s
		lb_try_duration 5s
		lb_try_interval 200ms

		# Mercure streams are long-lived: pass bytes through as they arrive.
		flush_interval -1
	}
}
